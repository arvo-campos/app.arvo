# Copie este arquivo para ".env" (local) ou configure estas variáveis
# diretamente no painel da Vercel (produção). Nenhum valor real deve ser
# commitado no git — o ".env" de verdade já está no .gitignore.

# Banco de dados Postgres. Na Vercel, adicionar a integração "Postgres"
# (Storage → Postgres) preenche essa variável automaticamente.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"

# Token de acesso ao Vercel Blob (armazenamento de fotos). Adicionar a
# integração "Blob" (Storage → Blob) preenche essa variável automaticamente.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Chave usada para assinar as sessões de login (cookie JWT). Gere uma nova
# e forte para produção — não reaproveite a de desenvolvimento.
# Gerar uma nova: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Endereço público onde o app está publicado (sem barra no final).
# Usado para montar links em e-mails de notificação.
NEXT_PUBLIC_APP_URL="https://seu-app.vercel.app"

# Opcional — só necessário se quiser ativar o envio real de e-mail de
# notificação. Sem isso, o app funciona normalmente e só registra a
# notificação no log do servidor em vez de enviar de verdade.
# RESEND_API_KEY=""

# Opcional — usado só pelo script prisma/seed-producao.ts, define qual
# e-mail vai receber a conta de admin criada. Se omitido, usa
# admin@arvo.com.br.
# SEED_ADMIN_EMAIL=""
