generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Cliente {
  id          String    @id @default(uuid())
  nome        String
  responsavel String
  email       String
  telefone    String?
  eventos     Evento[]
  usuarios    Usuario[]
  createdAt   DateTime  @default(now())
}

model Evento {
  id         String     @id @default(uuid())
  nome       String
  clienteId  String
  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  local      String
  latitude   String?
  longitude  String?
  dataInicio DateTime
  dataFim    DateTime?
  status     String // "em_andamento" | "concluido"
  manejos    Manejo[]
  parcelas   Parcela[]
  vistorias  Vistoria[]
  createdAt  DateTime   @default(now())
}

model Parcela {
  id             String         @id @default(uuid())
  eventoId       String
  evento         Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nome           String // ex: "GH 2459"
  linhas         Int?
  largura        String?
  posX           Int
  posY           Int
  tipo           String // "parcela" | "corredor" | "rua"
  manejos        Manejo[]
  fotosVistoria  FotoVistoria[]
}

model Manejo {
  id             String    @id @default(uuid())
  eventoId       String
  evento         Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  parcelas       Parcela[]
  tipo           String // "plantio" | "aplicacao" | "montagem" | "organizacao"
  responsavel    String?
  acompanhamento String?
  data           DateTime
  horaInicio     String?
  horaFim        String?

  // Clima
  tempInicio  Float?
  tempFim     Float?
  umidInicio  Float?
  umidFim     Float?
  ventoInicio Float?
  ventoFim    Float?
  ultimaChuva String?

  // Plantio (nullable)
  equipamento      String?
  qtdLinhas        Int?
  espLinhas        Float?
  profundidade     Float?
  sementesPorMetro String?

  // Aplicação (nullable)
  tipoAplicacao String?
  ponta         String?
  volumePonta   String?
  numPontas     Int?
  espPontas     Float?
  altBarra      Float?
  pressao       Float?
  volCalda      Float?
  velocidade    Float?

  anotacoes   String?
  status      String // "pendente" | "aprovado" | "reprovado" | "concluido"
  fotos       Foto[]
  produtos    Produto[]
  historico   HistoricoAprovacao[]
  comentarios Comentario[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Produto {
  id          String  @id @default(uuid())
  manejoId    String
  manejo      Manejo  @relation(fields: [manejoId], references: [id], onDelete: Cascade)
  numTrat     Int
  nome        String
  ingrediente String
  doseHa      String
}

model Foto {
  id       String   @id @default(uuid())
  manejoId String
  manejo   Manejo   @relation(fields: [manejoId], references: [id], onDelete: Cascade)
  url      String
  legenda  String?
  criadoEm DateTime @default(now())
}

model HistoricoAprovacao {
  id         String   @id @default(uuid())
  manejoId   String
  manejo     Manejo   @relation(fields: [manejoId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  acao       String // "aprovado" | "reprovado"
  observacao String?
  criadoEm   DateTime @default(now())
}

model Comentario {
  id        String   @id @default(uuid())
  manejoId  String
  manejo    Manejo   @relation(fields: [manejoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  texto     String
  criadoEm  DateTime @default(now())
}

model Usuario {
  id          String                @id @default(uuid())
  nome        String
  email       String                @unique
  senha       String
  role        String // "admin" | "cliente"
  clienteId   String?
  cliente     Cliente?              @relation(fields: [clienteId], references: [id])
  historico   HistoricoAprovacao[]
  comentarios Comentario[]
  vistorias   Vistoria[]
  createdAt   DateTime              @default(now())
}

model Vistoria {
  id                   String         @id @default(uuid())
  eventoId             String
  evento               Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  autorId              String
  autor                Usuario        @relation(fields: [autorId], references: [id])
  data                 DateTime
  condicoes            String?
  observacoes          String?
  solicitaIntervencao  Boolean        @default(false)
  intervencaoDescricao String?
  fotos                FotoVistoria[]
  criadoEm             DateTime       @default(now())
}

model FotoVistoria {
  id         String    @id @default(uuid())
  vistoriaId String
  vistoria   Vistoria  @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)
  parcelaId  String?
  parcela    Parcela?  @relation(fields: [parcelaId], references: [id], onDelete: SetNull)
  url        String
  legenda    String?
  criadoEm   DateTime  @default(now())
}
